{
  // Worker capsa-banting: file statis game (hasil `npm run build` di dist) + API meja online di /games/capsabanting/api/*.
  // Game disajikan di sylvaniaharco.com/games/capsabanting/ (pola yang sama dengan doudizhu, capsa & games-mahjong0hk).
  // Nama harus sama dengan nama Worker di Cloudflare (yang tersambung ke repo ini).
  "name": "capsa-banting",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/games/capsabanting/api/*"]
  },
  // Route ini lebih spesifik dari `sylvaniaharco.com/games/capsa*` (Worker capsa), jadi Cloudflare memakai yang ini untuk /games/capsabanting.
  "routes": [{ "pattern": "sylvaniaharco.com/games/capsabanting*", "zone_name": "sylvaniaharco.com" }],
  // Meja online: satu Durable Object per kode meja (SQLite bawaan, tanpa D1); pencari meja Ranked: satu global
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "BantingRoom" },
      { "name": "LOBBY", "class_name": "BantingLobby" }
    ]
  },
  // Akun & koin ada di Worker Mahjong (akun bersama semua game). Ranked memanggilnya lewat service binding ke entrypoint CapsaBantingGate
  // (tukar tiket jadi data pemain + saldo + rating, selesaikan koin & rating tiap ronde). Worker Mahjong harus sudah ter-deploy dengan CapsaBantingGate.
  "services": [{ "binding": "MAHJONG", "service": "games-mahjong0hk", "entrypoint": "CapsaBantingGate" }],
  // Tambah class DO baru = tambah tag migrasi baru, jangan ubah yang lama.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BantingRoom", "BantingLobby"] }]
}
